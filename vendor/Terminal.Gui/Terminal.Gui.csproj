<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Terminal.Gui</AssemblyName>
    <RootNamespace>Terminal.Gui</RootNamespace>
    <Version>1.19.0</Version>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0168;CS0169;CS0414;SYSLIB0051;SYSLIB0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NStack.Core" Version="1.1.1" />
    <PackageReference Include="System.Management" Version="9.0.4" />
    <InternalsVisibleTo Include="MySsh.Tests" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="Terminal.Gui.LICENSE" />
  </ItemGroup>
</Project>
